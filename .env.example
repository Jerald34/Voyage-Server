NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voyage
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=voyage_session
SESSION_TTL_DAYS=30
PASSWORD_PEPPER=
ADMIN_EMAILS=admin@example.com
RESEND_API_KEY=
# Shared Redis-backed rate limiting. Required in production; leave blank in local dev
# unless you are testing the shared limiter. Do not put credentials in this example file.
RATE_LIMIT_REDIS_URL=
# Key prefix for shared rate-limit buckets in Redis.
RATE_LIMIT_PREFIX=voyage:rate-limit:
# Baseline max requests per window for the shared limiter.
RATE_LIMIT_BASELINE_MAX=300
EMAIL_FROM=Voyage <no-reply@example.com>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/auth/apple/callback
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT_MS=120000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.2
OPENROUTER_REASONING_EFFORT=medium
MODEL_PROVIDER=auto
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS_B64=
GOOGLE_AI_MODEL=gemini-3-flash-preview
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAX_CALLS_PER_RUN=20

# --- Place freshness gate ----------------------------------------------------
# General name/city PlaceSnapshot cache freshness, in days. Must be > 0.
PLACE_SNAPSHOT_TTL_DAYS=30
# Extra status-only Place Details requests one authorized saved read may start (0-100).
# 0 disables extra refreshes; it does NOT disable cached or provider-payload filtering.
PLACE_STATUS_MAX_REFRESHES_PER_READ=10
# Simultaneous in-flight status-only requests, shared process-wide (1-10).
PLACE_STATUS_REFRESH_CONCURRENCY=3
# Extra status-only requests one agent run may start. 0 disables them.
PLACE_STATUS_MAX_REFRESHES_PER_RUN=20
# Rolling per-process hourly cap on extra status-only requests. 0 disables them.
# This is a per-process limit, not a cluster-wide or monetary cap; a restart resets it.
PLACE_STATUS_MAX_REFRESHES_PER_HOUR=120
# Retry cooldown after a failed or status-less refresh, in milliseconds. Must be > 0.
PLACE_STATUS_RETRY_COOLDOWN_MS=300000
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
WEB_SEARCH_MAX_CALLS_PER_RUN=5
# Required in production: HMAC secret for one-time trip-review links.
# Generate with: openssl rand -hex 32
# Leave blank in local dev (signing review tokens will throw; other features unaffected).
TRIP_REVIEW_SECRET=
